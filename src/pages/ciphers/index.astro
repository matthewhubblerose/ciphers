---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const cipherEntries = await getCollection("ciphers");
const sortedCiphers = cipherEntries.sort((a, b) => {
  const orderA = a.data.order ?? 999;
  const orderB = b.data.order ?? 999;
  return orderA - orderB;
});

const difficultyColors = {
  beginner: "badge-success",
  intermediate: "badge-warning",
  advanced: "badge-error",
};
---

<BaseLayout title="Ciphers" description="Learn about different types of ciphers">
  <div class="container mx-auto px-4 py-8 max-w-6xl">
    <h1 class="text-4xl font-bold mb-4">Cipher Reference</h1>
    <p class="text-lg text-base-content/80 mb-8">
      Detailed guides on various cipher types used in the National Cipher Challenge.
    </p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        sortedCiphers.map((cipher) => (
          <a
            href={`/cipher-challenge/ciphers/${cipher.slug}/`}
            class="card bg-base-100 shadow-lg hover:shadow-xl transition-shadow"
          >
            <div class="card-body">
              <h2 class="card-title">
                {cipher.data.title}
                <span class={`badge ${difficultyColors[cipher.data.difficulty]}`}>
                  {cipher.data.difficulty}
                </span>
              </h2>
              <p class="text-base-content/70">{cipher.data.description}</p>
            </div>
          </a>
        ))
      }
    </div>

    {
      sortedCiphers.length === 0 && (
        <div class="alert alert-info">
          <span>No cipher articles have been published yet. Check back soon!</span>
        </div>
      )
    }
  </div>
</BaseLayout>
