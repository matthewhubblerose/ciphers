---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DeckPlayer from "../../components/DeckPlayer";
import { decks } from "../../data/decks";
export function getStaticPaths() {
  return decks.map((deck) => ({ params: { slug: deck.slug }, props: { deck } }));
}
const { deck } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title={deck.title + " — club deck"}>
  <header class="wrap deck-page-heading">
    <h1>{deck.title}</h1>
    <span>Visual demonstrations · {deck.duration}</span>
    <a href={`${base}/guides/transposition/`}>Excel guide ↗</a>
  </header>
  <div class="wrap presentation-wrap">
    <DeckPlayer deck={deck} client:load />
    <noscript>
      <p class="notice">
        Enable JavaScript to navigate and animate the slides. You can also print the complete deck.
      </p>
    </noscript>
  </div>
</BaseLayout>
