---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DeckPlayer from "../../components/DeckPlayer";
import { decks } from "../../data/decks";
export function getStaticPaths() {
  return decks.map((deck) => ({ params: { slug: deck.slug }, props: { deck } }));
}
const { deck } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title={deck.title + " — club deck"}>
  <header class="wrap page-intro">
    <p class="eyebrow">CLUB DECK / {deck.duration}</p>
    <h1>
      {deck.title}
      <span class="accent">.</span>
    </h1>
    <p>{deck.description}</p>
  </header>
  <div class="wrap">
    <nav class="deck-select" aria-label="Session decks">
      {decks.map((d) => (
        <a
          href={`${base}/decks/${d.slug}/`}
          aria-current={deck.slug === d.slug ? "page" : undefined}
        >
          {d.title}
        </a>
      ))}
      <a href={`${base}/guides/transposition/`}>Build a transposition tool in Excel ↗</a>
    </nav>
    <DeckPlayer deck={deck} client:load />
    <noscript>
      <p class="notice">
        Enable JavaScript to navigate and animate the slides. You can also print the complete deck.
      </p>
    </noscript>
  </div>
</BaseLayout>
