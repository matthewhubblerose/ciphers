---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Workbench from "../../components/tools/Workbench";
---

<BaseLayout
  title="Tools"
  description="Analyse, decipher and generate classical ciphers in one shared workbench."
>
  <div class="wrap page-intro">
    <p class="eyebrow">01 / EXPERIMENT</p>
    <h1>
      The workbench<span class="accent">.</span>
    </h1>
    <p>One message. A whole set of ways to find the pattern.</p>
  </div>
  <Workbench client:load />
  <noscript>
    <p class="wrap notice">
      Enable JavaScript to use the interactive cipher tools. The guides are available without it.
    </p>
  </noscript>
</BaseLayout>
