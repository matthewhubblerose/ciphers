---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Tools" description="Interactive cipher tools">
	<div class="container mx-auto px-4 py-8 max-w-6xl">
		<h1 class="text-4xl font-bold mb-4">Cipher Tools</h1>
		<p class="text-lg text-base-content/80 mb-8">
			Interactive tools to help you analyze and decode ciphers.
		</p>

		<div class="alert alert-info">
			<span>Interactive tools coming soon! We're building a suite of tools for cipher analysis and decoding.</span>
		</div>
	</div>
</BaseLayout>
