---
import BaseLayout from "../../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="Guides">
  <header class="wrap page-intro">
    <p class="eyebrow">02 / BUILD</p>
    <h1>
      Guides<span class="accent">.</span>
    </h1>
    <p>Step-by-step instructions, starting with the basics.</p>
  </header>
  <section class="wrap guide-cards">
    <div class="card-grid">
      <a class="resource-card" href={`${base}/guides/transposition/`}>
        <span class="card-number">GUIDE 01 / EXCEL</span>
        <span class="card-icon mono">5 2 4 1 3</span>
        <h3>Build a transposition tool in Excel</h3>
        <p>
          Start with your first formula. Build a grid from ciphertext, move its columns, and copy
          the decoded message.
        </p>
        <span class="card-bottom">
          Beginner friendly · Actual Excel screenshots <b>↗</b>
        </span>
      </a>
    </div>
  </section>
</BaseLayout>
