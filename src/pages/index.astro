---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout>
  <section class="hero wrap">
    <div>
      <p class="eyebrow">THE CODEBREAKER’S FIELD KIT</p>
      <h1>
        Every cipher
        <br />
        leaves a <em>clue.</em>
      </h1>
      <p class="hero-copy">
        Find the patterns. Follow your hunches. Turn a jumble of letters into your next discovery.
      </p>
      <div class="actions">
        <a class="button primary" href={`${base}/tools/`}>
          Open the workbench <span>↗</span>
        </a>
        <a class="text-link" href={`${base}/guides/`}>
          Learn where to start →
        </a>
      </div>
      <p class="small muted">No accounts. No uploads. Just you and the puzzle.</p>
    </div>
    <div class="hero-art" aria-label="An encrypted message becomes a discovery">
      <div class="art-top">
        <span>FIELD NOTE 001</span>
        <span class="status-dot">PATTERN FOUND</span>
      </div>
      <div class="cipher-lines">
        AOL V A O L Y<br />
        LEWSVYLYZ
        <br />
        <span class="highlight">A O L</span> ZLJYLA
        <br />
        PZ OPKKLU
      </div>
      <div class="art-rule"></div>
      <div class="art-answer">
        <span>SHIFT −7</span>
        <strong>
          THE SECRET
          <br />
          IS HIDDEN<span class="cursor">▏</span>
        </strong>
      </div>
      <span class="art-coordinate">51° N / 001° W</span>
    </div>
  </section>
  <section class="wrap explore">
    <div class="section-heading">
      <h2>Your next move</h2>
      <span>THREE WAYS IN</span>
    </div>
    <div class="card-grid">
      <a class="resource-card" href={`${base}/tools/`}>
        <span class="card-number">01 / EXPERIMENT</span>
        <span class="card-icon">⌁</span>
        <h3>Tools</h3>
        <p>Count letters, test a shift, rearrange columns. Your ideas, put to the test.</p>
        <span class="card-bottom">
          Six tools. One workbench. <b>↗</b>
        </span>
      </a>
      <a class="resource-card" href={`${base}/guides/`}>
        <span class="card-number">02 / UNDERSTAND</span>
        <span class="card-icon">≋</span>
        <h3>Guides</h3>
        <p>
          Build a transposition tool in Excel, starting with cells, references and your first
          formula.
        </p>
        <span class="card-bottom">
          Step-by-step instructions and Excel screenshots. <b>↗</b>
        </span>
      </a>
      <a class="resource-card" href={`${base}/decks/`}>
        <span class="card-number">03 / SHARE</span>
        <span class="card-icon">▤</span>
        <h3>Decks</h3>
        <p>An animated deck on using frequency patterns to identify which cipher was used.</p>
        <span class="card-bottom">
          Interactive charts and presenter notes. <b>↗</b>
        </span>
      </a>
    </div>
  </section>
  <section class="wrap field-tip">
    <span class="eyebrow">A FIRST CLUE</span>
    <p>
      The most common letter in English is <strong>E</strong>.<br />
      But the most common letter in your cipher? That’s where the investigation begins.
    </p>
    <a class="text-link" href={`${base}/tools/#frequency`}>
      Investigate a frequency plot →
    </a>
  </section>
</BaseLayout>
