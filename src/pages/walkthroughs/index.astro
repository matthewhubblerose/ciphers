---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const walkthroughEntries = await getCollection("walkthroughs", ({ data }) => {
  return !data.draft;
});
const sortedWalkthroughs = walkthroughEntries.sort((a, b) => {
  return b.data.week - a.data.week; // Most recent first
});

const difficultyColors = {
  beginner: "badge-success",
  intermediate: "badge-warning",
  advanced: "badge-error",
};
---

<BaseLayout
  title="Walkthroughs"
  description="Step-by-step walkthroughs of Cipher Challenge problems"
>
  <div class="container mx-auto px-4 py-8 max-w-6xl">
    <h1 class="text-4xl font-bold mb-4">Challenge Walkthroughs</h1>
    <p class="text-lg text-base-content/80 mb-8">
      Detailed walkthroughs published weekly after submissions close. Learn how to approach and
      solve each challenge.
    </p>

    <div class="space-y-4">
      {
        sortedWalkthroughs.map((walkthrough) => (
          <a
            href={`/cipher-challenge/walkthroughs/${walkthrough.slug}`}
            class="card bg-base-100 shadow-lg hover:shadow-xl transition-shadow block"
          >
            <div class="card-body">
              <div class="flex justify-between items-start flex-wrap gap-2">
                <h2 class="card-title text-2xl">{walkthrough.data.title}</h2>
                <div class="flex gap-2 items-center">
                  <span class="badge badge-neutral">Week {walkthrough.data.week}</span>
                  <span class={`badge ${difficultyColors[walkthrough.data.difficulty]}`}>
                    {walkthrough.data.difficulty}
                  </span>
                </div>
              </div>
              <p class="text-base-content/70">{walkthrough.data.description}</p>
              <div class="flex gap-2 flex-wrap mt-2">
                {walkthrough.data.ciphers.map((cipher) => (
                  <span class="badge badge-outline">{cipher}</span>
                ))}
              </div>
              <div class="text-sm text-base-content/60">
                {walkthrough.data.publishDate.toLocaleDateString("en-GB", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </div>
            </div>
          </a>
        ))
      }
    </div>

    {
      sortedWalkthroughs.length === 0 && (
        <div class="alert alert-info">
          <span>
            No walkthroughs have been published yet. Check back after challenge submissions close!
          </span>
        </div>
      )
    }
  </div>
</BaseLayout>
