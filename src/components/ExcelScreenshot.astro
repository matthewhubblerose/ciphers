---
interface Props {
  name: string;
  alt: string;
  caption: string;
  series?: "window" | "lesson";
}
const { name, alt, caption, series = "window" } = Astro.props;
const src = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/images/excel/${series}-${name}.png`;
---

<figure class="excel-figure">
  <a href={src} target="_blank" rel="noreferrer" aria-label={`Open full-size screenshot: ${alt}`}>
    <img
      src={src}
      alt={alt}
      width={series === "lesson" ? 925 : 914}
      height={series === "lesson" ? 465 : 463}
      loading="lazy"
      decoding="async"
    />
  </a>
  <figcaption>
    {caption}{" "}
    <a href={src} target="_blank" rel="noreferrer">
      Open full size ↗
    </a>
  </figcaption>
</figure>
