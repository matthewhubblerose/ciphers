---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const links = [
  ["tools", "Tools"],
  ["guides", "Guides"],
  ["decks", "Decks"],
];
---

<header class="site-header">
  <a class="brand" href={`${base}/`} aria-label="Ciphers home">
    <span class="brand-mark" aria-hidden="true">
      C↔
    </span>{" "}
    ciphers<span class="brand-dot">.</span>
  </a>
  <nav aria-label="Main navigation">
    {links.map(([path, label]) => (
      <a
        href={`${base}/${path}/`}
        aria-current={Astro.url.pathname.includes(`/${path}`) ? "page" : undefined}
      >
        {label}
      </a>
    ))}
  </nav>
  <span class="header-note">A codebreaker’s field kit</span>
</header>
