---
const navItems = [
  { href: "/cipher-challenge/", label: "Home" },
  { href: "/cipher-challenge/walkthroughs/", label: "Walkthroughs" },
  { href: "/cipher-challenge/ciphers/", label: "Ciphers" },
  { href: "/cipher-challenge/analysis/", label: "Analysis" },
  { href: "/cipher-challenge/tools/", label: "Tools" },
];
---

<nav class="navbar bg-base-100 shadow-lg">
  <div class="navbar-start">
    <div class="dropdown">
      <div tabindex="0" role="button" class="btn btn-ghost lg:hidden">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h8m-8 6h16"></path>
        </svg>
      </div>
      <ul
        tabindex="0"
        class="menu menu-sm dropdown-content bg-base-100 rounded-box z-[1] mt-3 w-52 p-2 shadow"
      >
        {
          navItems.slice(1).map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <a href="/cipher-challenge/" class="btn btn-ghost text-xl">Cipher Challenge</a>
  </div>
  <div class="navbar-center hidden lg:flex">
    <ul class="menu menu-horizontal px-1">
      {
        navItems.slice(1).map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="navbar-end">
    <a
      href="https://www.cipherchallenge.org/"
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-primary btn-sm"
    >
      Official Challenge
    </a>
  </div>
</nav>
