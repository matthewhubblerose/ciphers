---
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	description: string;
	publishDate?: Date;
	difficulty?: 'beginner' | 'intermediate' | 'advanced';
}

const { title, description, publishDate, difficulty } = Astro.props;

const difficultyColors = {
	beginner: 'badge-success',
	intermediate: 'badge-warning',
	advanced: 'badge-error',
};
---

<BaseLayout title={title} description={description}>
	<article class="container mx-auto px-4 py-8 max-w-4xl">
		<header class="mb-8">
			<h1 class="text-4xl font-bold mb-4">{title}</h1>
			<div class="flex flex-wrap gap-3 items-center text-sm">
				{difficulty && (
					<span class={`badge ${difficultyColors[difficulty]}`}>
						{difficulty.charAt(0).toUpperCase() + difficulty.slice(1)}
					</span>
				)}
				{publishDate && (
					<time class="text-base-content/70">
						{publishDate.toLocaleDateString('en-GB', {
							year: 'numeric',
							month: 'long',
							day: 'numeric',
						})}
					</time>
				)}
			</div>
			<p class="text-lg text-base-content/80 mt-4">{description}</p>
		</header>

		<div class="prose prose-lg max-w-none">
			<slot />
		</div>
	</article>
</BaseLayout>
