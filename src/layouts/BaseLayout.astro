---
import Navigation from "../components/layout/Navigation.astro";
import Footer from "../components/layout/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ciphers — a codebreaker’s field kit",
  description = "A practical cipher workbench, step-by-step guides and classroom slide decks for young codebreakers.",
} = Astro.props;

const fullTitle = title.includes("field kit") ? title : `${title} | Ciphers`;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`}
    />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Navigation />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
