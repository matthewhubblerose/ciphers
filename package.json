{
  "name": "ciphers",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "overrides": {
      "rollup": "^4.67.4"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "check": "astro check",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm format:check && pnpm check && pnpm lint && pnpm test:run && pnpm build && pnpm test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.1",
    "astro": "^7.4.5",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
